# Minecraft bot account (offline/cracked)
MC_USERNAME=your_username
MC_AUTH=offline

# Server password for /register and /login
SERVER_PASSWORD=your_server_password

# Pika-Network server info
MC_HOST=play.pika-network.net
MC_PORT=25565
MC_VERSION=1.20.1

# Prefix for stat command (default: .)
CMD_PREFIX=.

# Default stats interval: total | monthly | weekly
DEFAULT_INTERVAL=total

# Default mode: ALL_MODES | SOLO | DOUBLES | TRIPLES | QUADS
DEFAULT_MODE=ALL_MODES

# SOCKS5 Proxy (format: ip:port:user:pass or ip:port)
# Leave empty if not using proxy
SOCKS5_PROXY=ip:port:user:pass
